        }

    }

    public virtual void Entrada0_ProcessInput(Entrada0Buffer Buffer)
    {
        while (Buffer.NextRow())
        {
            Entrada0_ProcessInputRow(Buffer);
        }
    }

    public virtual void Entrada0_ProcessInputRow(Entrada0Buffer Row)
    {
    }

}

